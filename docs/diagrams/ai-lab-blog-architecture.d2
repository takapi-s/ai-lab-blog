direction: down
style.fill: "#0d1117"
style.font-color: "#edf2f7"
style.font-size: 22

user: User {
  style.fill: "#151c25"
  style.stroke: "#f2c078"
  style.font-color: "#edf2f7"
  style.font-size: 24
}

miniPC: Local miniPC {
  style.fill: "#111c1b"
  style.stroke: "#45c99b"
  style.font-color: "#edf2f7"
  style.font-size: 24
  hermes: Hermes Agent {
    style.fill: "#17342f"
    style.stroke: "#85e0c0"
    style.font-color: "#edf2f7"
    style.font-size: 24
    runtime: "local automation"
    role: "drafts + PR support"
  }
}

github: GitHub {
  style.fill: "#171525"
  style.stroke: "#c4a7ff"
  style.font-color: "#edf2f7"
  style.font-size: 24
  repo: Repository {
    style.fill: "#211c32"
    style.stroke: "#c4a7ff"
    style.font-color: "#edf2f7"
    notes: "src/content/notes/*.md(x)"
    diagrams: "docs/diagrams/*.d2"
  }
  actions: Actions {
    style.fill: "#211c32"
    style.stroke: "#c4a7ff"
    style.font-color: "#edf2f7"
    trigger: "pull_request / push main"
  }
}

build: Astro 7 {
  style.fill: "#15332d"
  style.stroke: "#85e0c0"
  style.font-color: "#edf2f7"
  style.font-size: 24
  typescript: TypeScript
  content: "MDX + React components"
}

preview: PR Preview {
  style.fill: "#35242b"
  style.stroke: "#f29aaa"
  style.font-color: "#edf2f7"
  style.font-size: 24
  build: Astro build
  deploy: Wrangler
  target: "Cloudflare Workers Static Assets"
  name: "ai-lab-blog-pr-<PR number>"
}

production: Main Production {
  style.fill: "#352c20"
  style.stroke: "#f2c078"
  style.font-color: "#edf2f7"
  style.font-size: 24
  build: Astro build
  deploy: Wrangler
  target: "Cloudflare Workers Static Assets"
  name: "ai-lab-blog"
}

browser: End User Browser {
  style.fill: "#152936"
  style.stroke: "#7dd3fc"
  style.font-color: "#edf2f7"
  style.font-size: 24
}

user -> miniPC.hermes: "writing instruction"
miniPC.hermes -> github.repo.notes: "article draft"
miniPC.hermes -> github.actions: "create / review PR"
github.repo -> build: "change"
build -> github.actions: "build"
github.actions -> preview: "pull_request"
github.actions -> production: "push main"
preview -> browser: "preview URL"
production -> browser: "production URL"
