---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={note.data.description} />
    <title>{note.data.title} — Field Notes</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Field Notes home">
          <span class="brand-mark">FN</span>
          <span>FIELD NOTES</span>
        </a>
        <nav class="nav" aria-label="メインナビゲーション">
          <a href="/#notes">Notes</a>
          <a href="/gear/">Gear</a>
          <a href="/contact/">Contact</a>
          <a href="/#about">About</a>
        </nav>
      </header>

      <main class="article-shell">
        <a class="back-link" href="/">← Back to notes</a>
        <div class="article-meta">
          <span>{note.data.category}</span>
          <time datetime={note.data.pubDate.toISOString()}>{note.data.pubDate.toLocaleDateString("ja-JP")}</time>
        </div>
        <h1>{note.data.title}</h1>
        <p class="article-lead">{note.data.description}</p>
        <section class="experiment-panel" aria-label="実験概要">
          <div>
            <span class="panel-label">STATUS</span>
            <strong>{note.data.status}</strong>
          </div>
          <div class="stack-list">
            <span class="panel-label">STACK</span>
            <div>
              {note.data.stack.map((item) => <span class="stack-chip">{item}</span>)}
            </div>
          </div>
        </section>
        <article class="article-content">
          <Content />
        </article>
      </main>
    </div>
  </body>
</html>

<style>
  .article-shell { max-width: 760px; margin: 0 auto; padding: 76px 0; }
  .back-link { color: var(--muted); font-size: 14px; }
  .back-link:hover { color: var(--accent); }
  .article-meta { display: flex; gap: 16px; margin-top: 64px; color: var(--accent); font-size: 12px; letter-spacing: .08em; }
  .article-meta time { color: var(--muted); }
  .article-shell h1 { max-width: none; margin: 18px 0; font-size: clamp(38px, 6vw, 64px); }
  .article-lead { color: var(--muted); font-size: 18px; line-height: 1.8; }
  .experiment-panel { display: grid; grid-template-columns: 150px 1fr; gap: 22px; margin-top: 34px; padding: 18px; background: var(--panel-soft); border: 1px solid var(--line); border-radius: 12px; }
  .panel-label { display: block; margin-bottom: 8px; color: var(--accent); font-size: 10px; font-weight: 700; letter-spacing: .14em; }
  .experiment-panel strong { font-size: 14px; }
  .stack-chip { display: inline-block; margin: 0 6px 6px 0; padding: 5px 8px; color: var(--muted); background: var(--panel); border: 1px solid var(--line); border-radius: 5px; font-size: 12px; }
  .article-content { margin-top: 54px; color: #d7dee7; font-size: 17px; line-height: 1.9; }
  .article-content :global(h2) { margin: 48px 0 14px; color: var(--text); font-size: 28px; }
  .article-content :global(p) { margin: 18px 0; }
  .article-content :global(li) { margin: 8px 0; }
  .article-content :global(img) { display: block; width: 100%; max-width: 100%; height: auto; margin: 24px 0; border: 1px solid var(--line); border-radius: 12px; }
  .article-content :global(pre) { overflow-x: auto; margin: 24px 0; padding: 20px; background: #080c11; border: 1px solid var(--line); border-radius: 12px; font-size: 14px; line-height: 1.6; }
  .article-content :global(code) { font-family: "SFMono-Regular", Consolas, monospace; }
</style>
